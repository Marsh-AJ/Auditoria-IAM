# =============================================================================
# PLANTILLA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# Sistema de Auditoría IAM - UPHARVEN C.A.
# =============================================================================
# Instrucciones:
# 1. Copie este archivo como '.env' en la raíz del proyecto:
#    cp .env.example .env (o Copy-Item .env.example .env en PowerShell)
# 2. Ajuste las credenciales y parámetros de conexión según su servidor MySQL.
# 3. NUNCA incluya contraseñas reales ni comitee el archivo '.env' al repositorio.
# =============================================================================

# Dirección IP o nombre de host del servidor MySQL Server
DB_HOST=localhost

# Puerto de escucha del servicio MySQL Server (predeterminado: 3306)
DB_PORT=3306

# Nombre de la base de datos relacional para el sistema
DB_NAME=auditoria_iam_upharven

# Usuario de base de datos con permisos sobre el esquema
DB_USER=auditor_iam

# Contraseña del usuario de base de datos MySQL
DB_PASSWORD=su_contraseña_segura_aqui

# Tiempo máximo de espera para la conexión en segundos (entero positivo, predeterminado: 10)
DB_CONNECT_TIMEOUT=10

